<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.torque">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Torque"
        android:theme="@style/Theme.TorqueLight">

        <activity
            android:name=".MenuPrincipal.MenuPrincipal"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity android:name=".maintenance.MaintenanceLog" />
        <activity android:name=".maintenance.MaintenanceForm" />
        <activity android:name=".maintenance.MantenimientoPreview" />
        <activity android:name=".maintenance.MantenimientoHistorial" />


        <activity android:name=".garage.MotoDetalle" />
        <activity android:name=".garage.AgregarMoto" />
        <activity android:name=".garage.BorrarMoto" />
        <activity android:name=".garage.ListaGarage" />

        <activity android:name=".perfil.PerfilActivity" />
        <activity android:name=".ajustes.AjustesActivity" />


    </application>
</manifest>